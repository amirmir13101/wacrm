# ============================================================
# REQUIRED - the app will not start without these.
# ============================================================

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and broadcast worker). Keep
# this secret - never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key - users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers -> App Settings -> Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required - without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# Meta App ID. Required when submitting message templates with image
# headers through Meta's resumable-upload API.
META_APP_ID=your-meta-app-id

# Meta Embedded Signup. Keep the app secret and system-user token server-only.
# Hosted signup must stay disabled until App Review + Access Verification are
# complete and the app-level account_update webhook has been verified.
META_EMBEDDED_SIGNUP_CONFIG_ID=your-meta-login-configuration-id
META_GRAPH_API_VERSION=v26.0
META_HOSTED_EMBEDDED_SIGNUP_ENABLED=false
META_HOSTED_EMBEDDED_SIGNUP_REDIRECT_URI=https://app.example.com/
META_SYSTEM_USER_ACCESS_TOKEN=your-meta-system-user-access-token

# ============================================================
# RECOMMENDED - safe defaults exist but you should set this.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap, OG images, and any email the app sends.
NEXT_PUBLIC_SITE_URL=https://talkwagon.chat

# ============================================================
# REQUIRED FOR SERVER-SIDE JOBS
# ============================================================

# Shared secret protecting server-side cron/worker endpoints:
#   GET/POST /api/whatsapp/broadcast/worker
#   GET /api/automations/cron
#   GET /api/flows/cron
#
# Required for production broadcast delivery. Generate any long random string:
#   openssl rand -hex 32
AUTOMATION_CRON_SECRET=generate-a-long-random-string
